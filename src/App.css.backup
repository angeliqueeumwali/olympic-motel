
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #24231f;
  background: #fff;
  font-synthesis: none;
  --ink: #24231f;
  --muted: #77736b;
  --beige: #e9dfd0;
  --cream: #f7f5f0;
  --gold: #a88d65;
  --white: #fff;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  min-width: 320px;
  background: var(--white);
}

button, input, select {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* HEADER AND NAVIGATION */

.header {
  height: 86px;
  width: 100%;
  padding: 0 7%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: 0 3px 20px rgba(0, 0, 0, 0.045);
}

.brand {
  display: flex;
  flex-direction: column;
  width: fit-content;
  color: var(--ink);
}

.brand-name {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 27px;
  font-weight: 600;
  letter-spacing: 4px;
  line-height: 1;
}

.brand-subtitle {
  margin-top: 7px;
  font-size: 9px;
  letter-spacing: 3.5px;
  color: var(--gold);
}

.navigation {
  display: flex;
  align-items: center;
  gap: 34px;
}

.navigation > a:not(.nav-book) {
  color: #46433e;
  font-size: 13px;
  transition: color .25s ease;
}

.navigation > a:not(.nav-book):hover {
  color: var(--gold);
}

.nav-book {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--ink);
  color: #fff;
  padding: 15px 21px;
  font-size: 12px;
  transition: background .25s ease;
}

.nav-book:hover {
  background: var(--gold);
}

.menu-toggle {
  display: none;
  background: none;
  border: 0;
  cursor: pointer;
  color: var(--ink);
}

/* HERO */

.hero {
  min-height: 670px;
  height: calc(88vh - 86px);
  max-height: 850px;
  position: relative;
  display: flex;
  align-items: center;
  padding: 80px 10%;
  color: #fff;
  overflow: hidden;
  background: #62594c;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    rgba(20, 19, 17, .78) 0%,
    rgba(20, 19, 17, .47) 48%,
    rgba(20, 19, 17, .08) 100%
  );
}

.hero-content {
  max-width: 690px;
  position: relative;
  z-index: 1;
}

.hero-eyebrow,
.eyebrow {
  display: inline-block;
  color: var(--gold);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 3px;
  line-height: 1.8;
}

.hero-eyebrow {
  color: #e5d6bd;
  margin-bottom: 26px;
}

.hero h1 {
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 400;
  font-size: clamp(46px, 6.3vw, 82px);
  line-height: 1.1;
  letter-spacing: -1.5px;
}

.hero h1 em {
  color: #e8d7bc;
  font-weight: 400;
}

.hero-content > p {
  max-width: 470px;
  color: #e7e4de;
  font-size: 14px;
  line-height: 1.9;
  margin-top: 25px;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 30px;
  margin-top: 36px;
  flex-wrap: wrap;
}

.button {
  min-height: 52px;
  padding: 0 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 17px;
  border: 0;
  cursor: pointer;
  font-size: 12px;
  letter-spacing: .3px;
  transition: background .25s, transform .25s;
}

.button:hover {
  transform: translateY(-2px);
}

.button-light {
  color: var(--ink);
  background: #f3eadc;
}

.button-light:hover {
  background: white;
}

.hero-text-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: white;
}

.hero-bottom {
  position: absolute;
  z-index: 1;
  bottom: 27px;
  left: 10%;
  right: 10%;
  display: flex;
  justify-content: space-between;
  color: #e9e4db;
  font-size: 9px;
  letter-spacing: 2px;
}

/* INTRO STRIP */

.intro-strip {
  min-height: 90px;
  padding: 22px 10%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: var(--cream);
}

.intro-strip > div,
.intro-strip > a {
  display: flex;
  align-items: center;
  gap: 11px;
  font-size: 12px;
}

.intro-strip > div svg {
  color: var(--gold);
}

.intro-strip p {
  color: var(--muted);
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 17px;
  font-style: italic;
}

.intro-strip > a {
  color: var(--ink);
}

/* GENERAL SECTION STYLES */

.section-padding {
  padding: 110px 10%;
}

.section-heading {
  max-width: 620px;
  margin: 0 auto 50px;
  text-align: center;
}

.section-heading h2,
.about-content h2,
.highlight-content h2,
.booking-intro h2,
.contact h2 {
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 400;
  font-size: clamp(36px, 4vw, 51px);
  line-height: 1.2;
  color: var(--ink);
  margin-top: 13px;
}

.section-heading > p {
  max-width: 520px;
  margin: 17px auto 0;
  font-size: 13px;
  line-height: 1.9;
  color: var(--muted);
}

/* ABOUT */

.about {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 90px;
  align-items: center;
}

.about-image {
  height: 510px;
  position: relative;
  background: var(--beige);
}

.image-caption {
  position: absolute;
  bottom: 20px;
  left: 20px;
  background: white;
  color: var(--ink);
  padding: 12px 17px;
  font-size: 9px;
  letter-spacing: 2px;
}

.about-content h2 {
  max-width: 450px;
  margin-bottom: 24px;
}

.about-content > p {
  font-size: 13px;
  line-height: 2;
  color: var(--muted);
  margin-bottom: 17px;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-top: 15px;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--gold);
  font-size: 12px;
}

/* ROOMS */

.rooms {
  background: var(--cream);
}

.room-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.room-card {
  background: white;
}

.room-image {
  height: 310px;
  position: relative;
  background: var(--beige);
  overflow: hidden;
}

.room-image img,
.gallery-item img {
  transition: transform .6s ease;
}

.room-card:hover .room-image img,
.gallery-item:hover img {
  transform: scale(1.045);
}

.room-number {
  position: absolute;
  top: 17px;
  left: 17px;
  background: white;
  padding: 10px 13px;
  font-size: 10px;
  letter-spacing: 1px;
}

.room-info {
  padding: 24px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.room-info h3 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 21px;
  font-weight: 400;
}

.room-info p {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.8;
  margin-top: 8px;
}

.room-info > a {
  flex-shrink: 0;
  display: grid;
  place-items: center;
  width: 39px;
  height: 39px;
  border: 1px solid #e7e1d8;
  transition: all .25s;
}

.room-info > a:hover {
  background: var(--ink);
  color: white;
}

/* HIGHLIGHT */

.highlight {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 500px;
  background: var(--beige);
}

.highlight-image {
  min-height: 500px;
  background:
    url('/images/feature.jpg') center / cover no-repeat,
    linear-gradient(135deg, #c4b39a, #837765);
}

.highlight-content {
  padding: 80px 12%;
  align-self: center;
}

.highlight-content h2 {
  max-width: 460px;
}

.highlight-content p {
  color: #69645c;
  font-size: 13px;
  line-height: 2;
  margin: 22px 0 30px;
}

.button-dark {
  color: white;
  background: var(--ink);
}

.button-dark:hover {
  background: var(--gold);
}

/* GALLERY */

.gallery-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  grid-template-rows: 230px 230px;
  gap: 15px;
}

.gallery-item {
  overflow: hidden;
  background: var(--beige);
}

.gallery-item-1 {
  grid-row: span 2;
}

.gallery-item-4 {
  grid-column: span 2;
}

/* BOOKING */

.booking {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 80px;
  align-items: start;
  background: var(--cream);
}

.booking-intro {
  padding-top: 25px;
}

.booking-intro h2 {
  max-width: 420px;
}

.booking-intro > p {
  max-width: 390px;
  color: var(--muted);
  font-size: 13px;
  line-height: 2;
  margin-top: 20px;
}

.booking-note {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-top: 35px;
  color: #716b61;
  font-size: 12px;
}

.booking-note svg {
  color: var(--gold);
}

.booking-form {
  padding: 38px;
  background: white;
  box-shadow: 0 10px 40px rgba(0, 0, 0, .045);
}

.booking-form h3 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 25px;
  font-weight: 400;
  margin-bottom: 27px;
}

.booking-form label {
  display: flex;
  flex-direction: column;
  gap: 9px;
  flex: 1;
  color: #514d46;
  font-size: 11px;
}

.booking-form input,
.booking-form select {
  width: 100%;
  height: 48px;
  padding: 0 13px;
  border: 1px solid #e8e3db;
  background: white;
  color: var(--ink);
  outline: none;
  font-size: 12px;
  border-radius: 0;
}

.booking-form input:focus,
.booking-form select:focus {
  border-color: var(--gold);
}

.form-row {
  display: flex;
  gap: 17px;
  margin-bottom: 20px;
}

.booking-form > label {
  margin-bottom: 20px;
}

.form-submit {
  width: 100%;
  margin-top: 5px;
}

.booking-form small {
  display: block;
  margin-top: 15px;
  color: #99938a;
  font-size: 10px;
  line-height: 1.7;
}

.form-message {
  padding: 12px;
  margin-top: 15px;
  background: var(--cream);
  color: #514d46;
  font-size: 12px;
  line-height: 1.7;
}

/* CONTACT */

.contact {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 50px;
}

.contact > div:first-child {
  max-width: 520px;
}

.contact h2 {
  margin-bottom: 18px;
}

.contact > div:first-child > p {
  color: var(--muted);
  font-size: 13px;
  line-height: 2;
}

.contact-card {
  min-width: 260px;
  padding: 32px;
  background: var(--cream);
}

.contact-icon {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  background: var(--beige);
  color: var(--gold);
  margin-bottom: 20px;
}

.contact-card h3 {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 24px;
  font-weight: 400;
  margin-top: 10px;
}

.contact-card p {
  color: var(--muted);
  font-size: 11px;
  margin-top: 10px;
}

/* FOOTER */

.footer {
  padding: 55px 10% 22px;
  background: #201f1c;
  color: white;
}

.footer-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  padding-bottom: 45px;
}

.footer-brand {
  color: white;
}

.footer-main > p {
  color: #c1bbb1;
  font-size: 12px;
}

.back-top {
  font-size: 11px;
  color: #e5d6bd;
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, .13);
  padding-top: 20px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: #aaa49a;
  font-size: 10px;
}

/* TABLET AND MOBILE */

@media (max-width: 950px) {
  .header {
    padding: 0 5%;
  }

  .navigation {
    gap: 19px;
  }

  .section-padding {
    padding: 85px 7%;
  }

  .about {
    gap: 45px;
  }

  .booking {
    gap: 40px;
  }

  .room-image {
    height: 250px;
  }
}

@media (max-width: 700px) {
  .header {
    height: 75px;
    padding: 0 6%;
  }

  .brand-name {
    font-size: 24px;
  }

  .menu-toggle {
    display: block;
  }

  .navigation {
    display: none;
    position: absolute;
    top: 75px;
    left: 0;
    right: 0;
    padding: 25px 7% 30px;
    background: white;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    box-shadow: 0 12px 20px rgba(0, 0, 0, .08);
  }

  .navigation.navigation-open {
    display: flex;
  }

  .navigation > a:not(.nav-book) {
    padding: 15px 0;
    border-bottom: 1px solid #eeeae4;
  }

  .nav-book {
    justify-content: center;
    margin-top: 17px;
  }

  .hero {
    min-height: 610px;
    height: 78vh;
    padding: 60px 7%;
    background-position: center;
  }

  .hero h1 {
    font-size: clamp(43px, 11vw, 65px);
  }

  .hero-bottom {
    left: 7%;
    right: 7%;
  }

  .intro-strip {
    padding: 25px 7%;
    flex-wrap: wrap;
  }

  .intro-strip p {
    display: none;
  }

  .section-padding {
    padding: 75px 7%;
  }

  .about,
  .booking,
  .highlight {
    grid-template-columns: 1fr;
  }

  .about {
    gap: 40px;
  }

  .about-image {
    height: 370px;
  }

  .room-grid {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .room-image {
    height: 330px;
  }

  .highlight-image {
    min-height: 330px;
  }

  .highlight-content {
    padding: 65px 7%;
  }

  .gallery-grid {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 200px 160px 160px;
  }

  .gallery-item-1 {
    grid-row: auto;
    grid-column: span 2;
  }

  .gallery-item-4 {
    grid-column: span 1;
  }

  .booking {
    gap: 35px;
  }

  .booking-form {
    padding: 25px 20px;
  }

  .contact {
    flex-direction: column;
    align-items: stretch;
  }

  .contact-card {
    min-width: 0;
  }

  .footer {
    padding: 45px 7% 20px;
  }

  .footer-main {
    flex-direction: column;
    align-items: flex-start;
  }

  .footer-bottom {
    flex-direction: column;
    line-height: 1.7;
  }
}

@media (max-width: 420px) {
  .form-row {
    flex-direction: column;
  }

  .hero-actions {
    gap: 20px;
  }

  .hero-text-link {
    margin-left: 2px;
  }
}


/* AUTOMATIC HERO SLIDESHOW */

.hero-slides {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero-slide {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  transform: scale(1.04);
  transition: opacity 1.5s ease, transform 6s ease;
}

.hero-slide.active {
  opacity: 1;
  transform: scale(1);
}

.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    90deg,
    rgba(20, 19, 17, .78) 0%,
    rgba(20, 19, 17, .47) 48%,
    rgba(20, 19, 17, .08) 100%
  );
}

.hero-content,
.hero-bottom {
  z-index: 2;
}

.slide-indicators {
  display: flex;
  align-items: center;
  gap: 9px;
}

.indicator {
  width: 25px;
  height: 3px;
  border: 0;
  cursor: pointer;
  background: rgba(255, 255, 255, .45);
  transition: all .3s ease;
}

.indicator.active {
  width: 48px;
  background: #e8d7bc;
}


/* MOTEL PHONE AND WHATSAPP CONTACT */

.nav-phone {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #a88d65;
}

.contact-actions {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 22px;
}

.contact-actions a {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  color: #514d46;
}

.contact-actions a:hover,
.nav-phone:hover {
  color: #a88d65;
}

@media (max-width: 700px) {
  .nav-phone {
    padding: 15px 0;
    border-bottom: 1px solid #eeeae4;
  }
}

/* Prioritize and display hero slideshow images */
.hero-slide {
  overflow: hidden;
  background-image: none !important;
}

.hero-slide img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* =========================================
   MULTI-PROPERTY WEBSITE
   ========================================= */

.collection-about {
  display: grid;
  grid-template-columns: 90px 1fr;
  align-items: center;
  gap: 35px;
  background: #fff;
}

.collection-about-icon {
  width: 75px;
  height: 75px;
  display: grid;
  place-items: center;
  background: var(--cream);
  color: var(--gold);
}

.collection-about h2 {
  margin-top: 12px;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 400;
  color: var(--ink);
}

.collection-about p {
  max-width: 760px;
  margin-top: 17px;
  color: var(--muted);
  font-size: 13px;
  line-height: 2;
}

/* PROPERTY DIRECTORY */

.properties-overview {
  background: var(--cream);
}

.property-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
}

.property-directory-card {
  display: block;
  background: #fff;
  overflow: hidden;
}

.directory-card-image {
  height: 330px;
  position: relative;
  background: var(--beige);
  overflow: hidden;
}

.directory-card-image .property-image {
  height: 100%;
}

.directory-card-image img {
  transition: transform .6s ease;
}

.property-directory-card:hover .directory-card-image img {
  transform: scale(1.045);
}

.directory-number {
  position: absolute;
  top: 18px;
  left: 18px;
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  background: white;
  color: var(--ink);
  font-size: 11px;
  letter-spacing: 1px;
}

.directory-card-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25px 27px;
}

.directory-card-info h3 {
  margin-top: 7px;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 27px;
  font-weight: 400;
}

.directory-card-info > svg {
  color: var(--gold);
}

/* INDIVIDUAL PROPERTY SECTIONS */

.property-detail {
  padding: 100px 10%;
  background: white;
  scroll-margin-top: 85px;
}

.property-alternate {
  background: var(--cream);
}

.property-detail-inner {
  max-width: 1250px;
  margin: 0 auto;
}

.property-title-row {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 35px;
  margin-bottom: 55px;
}

.property-title-row h2 {
  margin-top: 10px;
  font-family: 'Playfair Display', Georgia, serif;
  font-weight: 400;
  font-size: clamp(38px, 5vw, 58px);
  color: var(--ink);
}

.property-title-row p {
  max-width: 600px;
  margin-top: 15px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.9;
}

.property-enquiry-link {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 18px;
  background: var(--ink);
  color: white;
  font-size: 11px;
  transition: background .25s;
}

.property-enquiry-link:hover {
  background: var(--gold);
}

/* PHOTO COLLECTIONS */

.property-category {
  margin-top: 48px;
}

.property-category-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 19px;
}

.property-category-heading h3 {
  margin-top: 5px;
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 26px;
  font-weight: 400;
  color: var(--ink);
}

.photo-count {
  color: var(--muted);
  font-size: 10px;
}

.property-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15px;
}

.property-image {
  position: relative;
  height: 245px;
  overflow: hidden;
  background: var(--beige);
}

.property-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .5s ease;
}

.property-image:hover img {
  transform: scale(1.04);
}

.image-placeholder {
  width: 100%;
  height: 100%;
  min-height: 180px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10px;
  padding: 20px;
  text-align: center;
  background: linear-gradient(135deg, #eee7dc, #ded2c0);
  color: #756a59;
}

.image-placeholder span {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 17px;
}

.image-placeholder small {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-size: 9px;
  color: #877d70;
}

/* BOOKING FORM ADDITIONS */

.booking-form textarea {
  width: 100%;
  min-height: 105px;
  padding: 13px;
  resize: vertical;
  border: 1px solid #e8e3db;
  background: white;
  color: var(--ink);
  font: inherit;
  font-size: 12px;
  outline: none;
  border-radius: 0;
}

.booking-form textarea:focus {
  border-color: var(--gold);
}

.booking-form > label {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

/* RESPONSIVE PROPERTY LAYOUT */

@media (max-width: 950px) {
  .property-detail {
    padding: 85px 7%;
  }

  .property-title-row {
    align-items: flex-start;
  }

  .property-photo-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .directory-card-image {
    height: 280px;
  }
}

@media (max-width: 700px) {
  .collection-about {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .property-card-grid {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .directory-card-image {
    height: 280px;
  }

  .property-detail {
    padding: 70px 7%;
  }

  .property-title-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    margin-bottom: 35px;
  }

  .property-enquiry-link {
    width: 100%;
    justify-content: center;
  }

  .property-category {
    margin-top: 38px;
  }

  .property-category-heading h3 {
    font-size: 22px;
  }

  .property-photo-grid {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .property-image {
    height: 190px;
  }
}

@media (max-width: 420px) {
  .property-photo-grid {
    grid-template-columns: 1fr;
  }

  .property-image {
    height: 235px;
  }

  .directory-card-image {
    height: 235px;
  }
}
